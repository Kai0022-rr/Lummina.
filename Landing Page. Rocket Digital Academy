<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lumina Botanicals x Lee Sia — Rahasia Kulit Glowing Sempurna</title>
  
  <!-- Typography & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <style>
    /* CSS Variables & Global Styles - Warna sedikit disesuaikan untuk kesan lebih mewah */
    :root {
      --primary: #0bb8be; /* Coklat kemerahan elegan */
      --primary-hover: #80c9f3;
      --bg-cream: #FCF9F5; /* Cream lebih terang */
      --bg-surface: #FFFFFF;
      --text-dark: #1A1513; /* Hitam lebih pekat */
      --text-muted: #5F5552;
      --accent: #ffffff; /* Champagne/Rose Gold soft */
      --accent-soft: #F8F1EC;
      --border: #EEE2D9;
      --radius: 12px;
      --transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--bg-cream);
      color: var(--text-dark);
      line-height: 1.6;
    }

    h1, h2, h3, .brand-logo {
      font-family: 'Playfair Display', serif;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    img {
      max-width: 100%;
      height: auto;
      display: block;
    }

    /* Layout Components */
    .container {
      width: 90%;
      max-width: 1140px;
      margin: 0 auto;
    }

    /* Header & Navigation */
    header {
      padding: 1.5rem 0;
      position: sticky;
      top: 0;
      background-color: rgba(252, 249, 245, 0.95);
      backdrop-filter: blur(10px);
      z-index: 100;
      border-bottom: 1px solid rgba(238, 226, 217, 0.5);
    }

    .nav-wrapper {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .brand-logo {
      font-size: 1.6rem;
      font-weight: 700;
      color: var(--text-dark);
      letter-spacing: 0.5px;
    }

    .brand-logo span {
      color: var(--primary);
    }

    .nav-btn {
      background-color: var(--primary);
      color: #fff;
      padding: 0.7rem 1.6rem;
      border-radius: 50px;
      font-weight: 600;
      font-size: 0.9rem;
      transition: var(--transition);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .nav-btn:hover {
      background-color: var(--primary-hover);
      transform: translateY(-1px);
    }

    /* Hero Section */
    .hero {
      padding: 5rem 0 7rem;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 4rem;
      align-items: center;
    }

    @media (min-width: 992px) {
      .hero-grid {
        grid-template-columns: 1.1fr 0.9fr;
      }
    }

    .badge-wrapper {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }

    .badge {
      display: inline-block;
      padding: 0.4rem 1.2rem;
      background-color: var(--accent-soft);
      border: 1px solid var(--border);
      border-radius: 50px;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .ambassador-name {
      font-size: 0.95rem;
      color: var(--text-muted);
      font-style: italic;
    }

    .hero-content h1 {
      font-size: 3rem;
      line-height: 1.15;
      margin-bottom: 1.5rem;
      color: var(--text-dark);
    }

    @media (min-width: 768px) {
      .hero-content h1 {
        font-size: 4rem;
      }
    }

    .hero-content p {
      font-size: 1.15rem;
      color: var(--text-muted);
      margin-bottom: 2.5rem;
      max-width: 550px;
    }

    .cta-group {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      align-items: center;
    }

    .btn-primary {
      background-color: var(--primary);
      color: #fff;
      padding: 1rem 2.2rem;
      border-radius: 50px;
      font-weight: 700;
      font-size: 1rem;
      transition: var(--transition);
      box-shadow: 0 12px 24px rgba(142, 90, 68, 0.25);
    }

    .btn-primary:hover {
      background-color: var(--primary-hover);
      transform: translateY(-2px);
      box-shadow: 0 18px 30px rgba(142, 90, 68, 0.35);
    }

    .btn-secondary {
      background-color: transparent;
      color: var(--text-dark);
      padding: 1rem 2rem;
      border-radius: 50px;
      font-weight: 700;
      font-size: 1rem;
      border: 2px solid var(--border);
      transition: var(--transition);
    }

    .btn-secondary:hover {
      background-color: var(--accent-soft);
      border-color: var(--primary);
    }

    .hero-visual {
      position: relative;
    }

    .img-wrapper {
      position: relative;
      border-radius: 30px;
      overflow: hidden;
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.1);
      border: 5px solid #fff;
    }

    .img-wrapper img {
      width: 100%;
      height: 550px;
      object-fit: cover;
      /* Memfokuskan wajah pada crop gambar */
      object-position: center 20%; 
    }

    /* Benefits Section */
    .benefits {
      padding: 6rem 0;
      background-color: var(--bg-surface);
    }

    .section-title {
      text-align: center;
      max-width: 650px;
      margin: 0 auto 4rem;
    }

    .section-title h2 {
      font-size: 2.5rem;
      margin-bottom: 1rem;
    }

    .section-title p {
      color: var(--text-muted);
      font-size: 1.1rem;
    }

    .benefits-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    @media (min-width: 768px) {
      .benefits-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    .benefit-card {
      background-color: var(--bg-cream);
      padding: 3rem 2rem;
      border-radius: var(--radius);
      border: 1px solid var(--border);
      transition: var(--transition);
      text-align: center;
    }

    .benefit-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 35px rgba(0,0,0,0.06);
      background-color: #fff;
    }

    .icon-box {
      width: 70px;
      height: 70px;
      background-color: var(--accent);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.75rem;
      font-size: 1.75rem;
    }

    .benefit-card h3 {
      font-size: 1.4rem;
      margin-bottom: 0.9rem;
    }

    .benefit-card p {
      color: var(--text-muted);
      font-size: 1rem;
    }

    /* Form Section */
    .form-section {
      padding: 7rem 0;
      background-color: var(--bg-cream);
    }

    .form-card {
      background-color: var(--bg-surface);
      max-width: 700px;
      margin: 0 auto;
      padding: 4rem 3rem;
      border-radius: 30px;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.07);
      border: 1px solid var(--border);
    }

    @media (min-width: 768px) {
      .form-card {
        padding: 4.5rem 4rem;
      }
    }

    .form-card h2 {
      font-size: 2.2rem;
      text-align: center;
      margin-bottom: 0.75rem;
    }

    .form-card p {
      text-align: center;
      color: var(--text-muted);
      margin-bottom: 2.5rem;
      font-size: 1rem;
      max-width: 500px;
      margin-left: auto;
      margin-right: auto;
    }

    .form-group {
      margin-bottom: 1.5rem;
    }

    .form-group label {
      display: block;
      font-size: 0.9rem;
      font-weight: 700;
      margin-bottom: 0.6rem;
      color: var(--text-dark);
    }

    .form-control {
      width: 100%;
      padding: 1rem 1.25rem;
      border: 2px solid var(--border);
      border-radius: 10px;
      font-family: inherit;
      font-size: 1rem;
      background-color: #FAFAFA;
      transition: var(--transition);
    }

    .form-control:focus {
      outline: none;
      border-color: var(--primary);
      background-color: #FFF;
      box-shadow: 0 0 0 4px rgba(142, 90, 68, 0.1);
    }

    .submit-btn {
      width: 100%;
      padding: 1.1rem;
      background-color: var(--primary);
      color: #fff;
      border: none;
      border-radius: 10px;
      font-size: 1.1rem;
      font-weight: 700;
      cursor: pointer;
      transition: var(--transition);
      margin-top: 1rem;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .submit-btn:hover {
      background-color: var(--primary-hover);
      box-shadow: 0 10px 20px rgba(142, 90, 68, 0.2);
    }

    /* Footer */
    footer {
      padding: 3rem 0;
      border-top: 1px solid var(--border);
      text-align: center;
      color: var(--text-muted);
      font-size: 0.9rem;
      background-color: var(--bg-surface);
    }
  </style>
</head>
<body>

  <!-- Header Section -->
  <header>
    <div class="container nav-wrapper">
      <a href="#" class="brand-logo">Lumina<span>.</span></a>
      <a href="#register" class="nav-btn">Pesan Eksklusif</a>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-content">
          <div class="badge-wrapper">
            <span class="badge">Edisi Terbatas</span>
            <span class="ambassador-name">bersama Lee Sia</span>
          </div>
          <h1>Rahasia Kulit Glowing Sempurna Sang Bintang</h1>
          <p>
            Dapatkan kilau legendaris aktris papan atas. Formula premium Lumina Botanicals yang menyatu dengan kulit, memberikan hasil flawless dan sehat seketika.
          </p>
          <div class="cta-group">
            <a href="#register" class="btn-primary">Klaim Edisi Lee Sia</a>
            <a href="#benefits" class="btn-secondary">Lihat Hasilnya</a>
          </div>
        </div>
        <div class="hero-visual">
          <div class="img-wrapper">
            <!-- Gambar stok Aktris Korea/Asian (Placeholder berkualitas) -->
            <img 
              src="https://images.summitmedia-digital.com/cosmo/images/2022/11/26/laneige-1669469731.jpg" 
              alt="Aktris Lee Sia menggunakan Lumina Skincare"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="benefits" id="benefits">
    <div class="container">
      <div class="section-title">
        <h2>Perawatan Kelas Dunia untuk Kulitmu</h2>
        <p>Tiga pilar rahasia di balik kulit sempurna yang selalu tampak 'Camera-Ready'.</p>
      </div>
      <div class="benefits-grid">
        <div class="benefit-card">
  <div class="icon-box">
    <img src="https://cdn-icons-png.flaticon.com/512/6187/6187141.png" alt="Ikon Piksel Sempurna" class="card-icon" />
  </div>
  <h3>Piksel Sempurna</h3>
  <p>Teknologi menyamarkan pori secara instan, memberikan efek 'filter alami' yang halus.</p>
</div>
        <div class="benefit-card">
    <div class="icon-box">
      <img src="https://cdn-icons-png.flaticon.com/512/10786/10786586.png" alt="Ikon Nutrisi Royal Jeli" class="card-icon" />
    </div>
    <h3>Nutrisi Royal Jeli</h3>
    <p>Esens premium untuk meregenerasi sel, menjaga kulit tetap kenyal dan awet muda.</p>
  </div>
        <div class="benefit-card">
  <div class="icon-box">
    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcS2FoNcVH_ycZy0DnAhzpA8bOkovEqV7AYTY_LLciPFbF6KTVeVZL_QPmH4&s=10" alt="Ikon Proteksi Total" class="card-icon" />
  </div>
  <h3>Proteksi Total</h3>
  <p>Melindungi kulit dari radikal bebas dan stres akibat paparan cahaya panggung/layar.</p>
</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Form Section -->
  <section class="form-section" id="register">
    <div class="container">
      <div class="form-card">
        <h2>Pesan Koleksi Eksklusif Ini</h2>
        <p>Isi detail Anda di bawah ini untuk mengamankan Set Perawatan Lumina x Lee Sia edisi terbatas.</p>
        
        <form id="beautyForm" onsubmit="handleSubmit(event)">
          <div class="form-group">
            <label for="fullName">Nama Lengkap Anda</label>
            <input type="text" id="fullName" class="form-control" placeholder="Masukkan Nama Anda" required />
          </div>

          <div class="form-group">
            <label for="email">Alamat Email Aktif</label>
            <input type="email" id="email" class="form-control" placeholder="Masukkan Alamat Email Anda" required />
          </div>

          <div class="form-group">
            <label for="packageType">Pilih Paket Edisi Terbatas</label>
            <select id="packageType" class="form-control" required>
              <option value="" disabled selected>Pilih paket favorit Anda</option>
              <option value="basic">Set Dasar Glowing (2 Produk)</option>
              <option value="premium">Set Lengkap Bintang (5 Produk) - Terlaris!</option>
              <option value="luxury">Set Mewah Kolektor (Dengan Tanda Tangan)</option>
            </select>
          </div>

          <button type="submit" class="submit-btn">Pesan Sekarang</button>
        </form>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <div class="container">
      <p>&copy; 2026 Lumina Botanicals x Star Alliance. Semua Hak Dilindungi. By Saguna Beryl Haidar.</p>
    </div>
  </footer>

  <script>
    function handleSubmit(event) {
      event.preventDefault();
      const name = document.getElementById('fullName').value;
      alert(`Selamat ${name}! Pesanan Koleksi Eksklusif Anda telah kami terima. Tim kami akan menghubungi Anda melalui email dalam 24 jam.`);
      document.getElementById('beautyForm').reset();
    }
  </script>
</body>
</html>